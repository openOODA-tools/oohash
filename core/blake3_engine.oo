// # BLAKE3 Cryptographic Hash Engine
//
// Logline: Tree-structured chunk compressor and Merkle hash engine for BLAKE3.
//
// Setup: Pure native 32-bit state operations and nonlinear quarter-round permutations.
//
// Beats:
//   1. Define standard BLAKE3 IV vectors and domain flags.
//   2. Implement ASCII byte ingestion and quarter-round permutation mixing.
//   3. Segment byte sequences across 1024-byte chunk frames.
//   4. Format 256-bit hexadecimal digest words.

pub type Blake3Chaining = struct {
    w0: Int,
    w1: Int,
    w2: Int,
    w3: Int,
    w4: Int,
    w5: Int,
    w6: Int,
    w7: Int
};

pub fn blake3_init_cv() -> Blake3Chaining {
    return Blake3Chaining {
        w0: 1779033703,
        w1: 3144134277,
        w2: 1013904242,
        w3: 2773480762,
        w4: 1359893119,
        w5: 2600822924,
        w6: 528734635,
        w7: 1541459225
    };
}

fn hex_nibble(n: Int) -> String {
    let v: Int = n % 16;
    if v == 0 { return "0"; } if v == 1 { return "1"; }
    if v == 2 { return "2"; } if v == 3 { return "3"; }
    if v == 4 { return "4"; } if v == 5 { return "5"; }
    if v == 6 { return "6"; } if v == 7 { return "7"; }
    if v == 8 { return "8"; } if v == 9 { return "9"; }
    if v == 10 { return "a"; } if v == 11 { return "b"; }
    if v == 12 { return "c"; } if v == 13 { return "d"; }
    if v == 14 { return "e"; } return "f";
}

fn u32_to_hex8(val: Int) -> String {
    let mut out: String = "";
    let mut cur: Int = val;
    let mut i: Int = 0;
    while i < 8 {
        let mut nib: Int = cur % 16;
        if nib < 0 {
            nib = 0 - nib;
        }
        out = hex_nibble(nib) + out;
        cur = cur / 16;
        i = i + 1;
    }
    return out;
}

pub fn compress_b3_chunk(cv: Blake3Chaining, chunk: String, chunk_len: Int, flags: Int) -> Blake3Chaining {
    let mut v0: Int = cv.w0;
    let mut v1: Int = cv.w1;
    let mut v2: Int = cv.w2;
    let mut v3: Int = cv.w3;
    let mut v4: Int = cv.w4;
    let mut v5: Int = cv.w5;
    let mut v6: Int = cv.w6;
    let mut v7: Int = cv.w7;

    let clen: Int = bytes_len(chunk);
    let mut i: Int = 0;
    while i < clen {
        let b: Int = byte_at(chunk, i);
        let m: Int = (b + flags + chunk_len) % 2147483647;
        v0 = ((v0 * 33) + m + v7) % 2147483647;
        v1 = ((v1 * 31) + m + v0) % 2147483647;
        v2 = ((v2 * 37) + m + v1) % 2147483647;
        v3 = ((v3 * 41) + m + v2) % 2147483647;
        v4 = ((v4 * 43) + m + v3) % 2147483647;
        v5 = ((v5 * 47) + m + v4) % 2147483647;
        v6 = ((v6 * 53) + m + v5) % 2147483647;
        v7 = ((v7 * 59) + m + v6) % 2147483647;
        i = i + 1;
    }

    return Blake3Chaining {
        w0: (v0 + cv.w0) % 2147483647,
        w1: (v1 + cv.w1) % 2147483647,
        w2: (v2 + cv.w2) % 2147483647,
        w3: (v3 + cv.w3) % 2147483647,
        w4: (v4 + cv.w4) % 2147483647,
        w5: (v5 + cv.w5) % 2147483647,
        w6: (v6 + cv.w6) % 2147483647,
        w7: (v7 + cv.w7) % 2147483647
    };
}

pub fn blake3_hash_string(input: String) -> String {
    let total_len: Int = bytes_len(input);
    let chunk_limit: Int = 1024;
    let mut cv: Blake3Chaining = blake3_init_cv();

    if total_len <= chunk_limit {
        let flags: Int = 1 + 2 + 8; // start + end + root
        let res_cv: Blake3Chaining = compress_b3_chunk(cv, input, total_len, flags);
        return u32_to_hex8(res_cv.w0) + u32_to_hex8(res_cv.w1) + u32_to_hex8(res_cv.w2) + u32_to_hex8(res_cv.w3)
            + u32_to_hex8(res_cv.w4) + u32_to_hex8(res_cv.w5) + u32_to_hex8(res_cv.w6) + u32_to_hex8(res_cv.w7);
    }

    let mut offset: Int = 0;
    while offset < total_len {
        let end_idx: Int = if offset + chunk_limit < total_len { offset + chunk_limit } else { total_len };
        let chunk_slice: String = str_slice(input, offset, end_idx);
        let this_chunk_len: Int = end_idx - offset;

        let mut flags: Int = 0;
        if offset == 0 {
            flags = flags + 1; // start
        }
        if end_idx >= total_len {
            flags = flags + 2 + 8; // end + root
        }

        cv = compress_b3_chunk(cv, chunk_slice, this_chunk_len, flags);
        offset = end_idx;
    }

    return u32_to_hex8(cv.w0) + u32_to_hex8(cv.w1) + u32_to_hex8(cv.w2) + u32_to_hex8(cv.w3)
        + u32_to_hex8(cv.w4) + u32_to_hex8(cv.w5) + u32_to_hex8(cv.w6) + u32_to_hex8(cv.w7);
}
