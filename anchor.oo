// # Root Verification Anchor for oohash
//
// Logline: Top-level integration test orchestrating core, render, and ipc subsystem anchors.
//
// Setup: Demands zero ambient authority, verifying pure cryptographic and formatting logic.
//
// Beats:
//   1. Verify core cryptographic hashing engines (BLAKE3, SHA-256, SHA3-512).
//   2. Verify render subsystem formatting and JSON serialization.
//   3. Verify ipc subsystem argument parsing and JSON payload decoding.
//   4. Export top-level system verification routine for test harness.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn verify_all() -> Bool {
    if !verify_core() {
        return false;
    }
    if !verify_render() {
        return false;
    }
    if !verify_ipc() {
        return false;
    }
    return true;
}
